      "targets": [
        {
          "datasource": {"type": "loki", "uid": "loki"},
          "editorMode": "code",
          "expr": "topk(10, max by (traceId, sqlOperation, sql) (max_over_time({application=\"$application\", environment=~\"$environment\"} | json | event = \"SQL_EXECUTION\" | unwrap elapsedMs [$__range])))",
          "queryType": "instant",
          "refId": "A"
