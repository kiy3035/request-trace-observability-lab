local.file_match "application_json_logs" {
  path_targets = [{
    "__path__"     = "/var/log/app/*.json",
    "application" = "request-trace-observability-lab",
    "environment" = "local",
  }]
}

loki.source.file "application_json_logs" {
  targets    = local.file_match.application_json_logs.targets
  forward_to = [loki.process.application_json_logs.receiver]
}

loki.process "application_json_logs" {
  stage.json {
    expressions = {
      application = "application",
      environment = "environment",
      level       = "level",
    }
  }

  stage.labels {
    values = {
      application = "",
      environment = "",
      level       = "",
    }
  }

  stage.label_drop {
    values = ["filename"]
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
