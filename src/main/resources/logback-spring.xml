<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="applicationName"
                    source="spring.application.name" defaultValue="request-trace-observability-lab"/>
    <springProperty name="environment"
                    source="app.environment" defaultValue="local"/>
    <springProperty name="logFile"
                    source="logging.file.name" defaultValue="logs/application.json"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <logger>logger</logger>
                <thread>thread</thread>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <customFields>{"application":"${applicationName}","environment":"${environment}"}</customFields>
            <includeMdc>true</includeMdc>
            <includeKeyValuePairs>true</includeKeyValuePairs>
        </encoder>
    </appender>

    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${logFile}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${logFile}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <logger>logger</logger>
                <thread>thread</thread>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <customFields>{"application":"${applicationName}","environment":"${environment}"}</customFields>
            <includeMdc>true</includeMdc>
            <includeKeyValuePairs>true</includeKeyValuePairs>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>
</configuration>
